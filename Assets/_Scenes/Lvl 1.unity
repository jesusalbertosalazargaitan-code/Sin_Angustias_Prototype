  m_Script: {fileID: 11500000, guid: b2103a0ce62b8204390777381325d2f2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  historiaTexto: "Bit\xE1cora de exploraci\xF3n: \n\nTras d\xEDas siguiendo los rastros
    antiguos en esta regi\xF3n de Colombia, descubrimos esta pir\xE1mide escondida
    entre la maleza. Al examinar la base encontramos reliquias consagradas a Su\xE9
    y Ch\xEDa, las deidades muiscas del Sol y la Luna. \n\nHemos asegurado el per\xEDmetro,
    pero decidimos no subir a la cumbre todav\xEDa; las escalaras son inestables
    y el peligro en lo alto parece mucho mayor de lo que esper\xE1bamos."
  mensajeAviso: Presiona [E] para leer Registro
  avisoUI: {fileID: 1291127030}
  textoAvisoUI: {fileID: 749767662}
  panelHistoriaUI: {fileID: 336930032}
  textoHistoriaUI: {fileID: 172418045}
  teclaInteractuar: 101
  pausarJuegoAlLeer: 0
