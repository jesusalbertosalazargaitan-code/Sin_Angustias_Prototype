{
  "output": {
    "filePath": "repomix-output.txt",
    "style": "plain",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true
  },
  "include": [
    "Assets/_Scripts/CameraController.cs",
    "Assets/_Scripts/ElementsMove.cs",
    "Assets/_Scripts/EnemyIA.cs",
    "Assets/_Scripts/FriendlyIA.cs",
    "Assets/_Scripts/GameManager.cs",
    "Assets/_Scripts/IntermitentL.cs",
    "Assets/_Scripts/Objects.cs",
    "Assets/_Scripts/PlayerController.cs",
    "Assets/PlayerControllerInput.inputactions",
    "Assets/_Prefabs/Contain.prefab",
    "Assets/_Prefabs/Enemy.prefab",
    "Assets/_Prefabs/FrendlyIA.prefab",
    "Assets/_Prefabs/Player.prefab",
    "Assets/_Prefabs/rust_key.prefab",
    "Assets/_Scenes/MainMen*.unity",
    "Assets/_Scenes/Lvl 1.unity",
    "Assets/_Scenes/Lvl 2.unity",
    "ProjectSettings/EditorBuildSettings.asset",
    "ProjectSettings/TagManager.asset",
    "Packages/manifest.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "Library/**",
      "Temp/**",
      "obj/**",
      "Obj/**",
      "Logs/**",
      "UserSettings/**",
      "Builds/**",
      "MemoryCaptures/**",
      "ProjectFinalV3/**",
      "proyectoFinalSenaV3/**",
      "**/*.meta",
      "**/*.png",
      "**/*.jpg",
      "**/*.fbx",
      "**/*.blend",
      "**/*.wav",
      "**/*.mp3",
      "**/*.mp4",
      "**/*.psd",
      "**/*.tif",
      "**/*.csproj",
      "**/*.sln",
      "Assets/TextMesh Pro/**",
      "Assets/_AllSkyFree/**",
      "Assets/Fantasy Forest Environment Free Sample/**",
      "Assets/Mine/**",
      "Assets/StaffOfPain/**",
      "Assets/_Rust Key/**",
      "Assets/_Scripts/NewBehaviourScript.cs",
      "Assets/_Scripts/Test.cs",
      "Assets/_Scenes/lvl11.unity",
      "Assets/Kbh_skel.unity"
    ]
  }
}

