  1: using System.Collections;
  2: using System.Collections.Generic;
  3: using UnityEngine;
  4: using UnityEngine.AI;
  5: using UnityEngine.SceneManagement;
  6: 
  7: public class EnemyIA : MonoBehaviour
  8: {
  9:     // Variables configurables
 10:     
 11:     public float visionRate = 10f; // Distancia a la que te ve
 12:     public float roadRate = 30f; // Qué tan lejos puede ir al deambular
 13:     public float tiempoDeEspera = 3f;  // Tiempo que espera en cada punto al deambular
 14:     public float run = 3f; // Velocidad al perseguir
 15:     public float walk = 1.5f; // Velocidad al deambular
 16:     private float cronometro; // Para contar el tiempo de espera al deambular
 17:     private GameManager gameManager; // Referencia al GameManager para verificar el puntaje
 18:     public Transform jugador; // Arrastra aquí al Player
 19:     Animator anim; // Referencia al Animator para controlar las animaciones
 20:     private NavMeshAgent agente; // Componentes y estado interno
 21:     private PlayerController playerController; // Referencia al PlayerController para verificar si el jugador está en la zona segura
 22:     private bool jugadorEnVista; // Si el jugador está dentro del radio de visión
 23:     public bool walkUp = false; // Si el enemigo está caminando erguido (después de recoger 3 objetos)
 24:     bool GameOver = false; // Si el juego ha terminado (para evitar que la IA siga actuando después de ganar o perder)
 25:     void Start()
 26:     {
 27:         // Obtener referencias a componentes y objetos necesarios
 28:         playerController = GameObject.Find("Player").GetComponent<PlayerController>();
 29:         anim = GetComponent<Animator>();
 30:         gameManager = GameObject.Find("Game Manager").GetComponent<GameManager>();
 31:         agente = GetComponent<NavMeshAgent>();
 32:         jugador = GameObject.Find("Player").transform;
 33:         // Empezamos deambulando a un punto aleatorio
 34:         SetNuevoPuntoAleatorio();
 35:         // Iniciar la corrutina para cambiar a caminar erguido después de 30 segundos
 36:         StartCoroutine(StateAnim());
 37:     }
 38: 
 39:     void Update()
 40:     {
 41:         // Detección: ¿El jugador está cerca?
 42:         float distanciaAlJugador = Vector3.Distance(transform.position, jugador.position);
 43:         // El jugador está en vista si está dentro del radio de visión y el juego no ha terminado
 44:         if (distanciaAlJugador <= visionRate && GameOver == false)
 45:         {
 46:             jugadorEnVista = true; // El jugador está dentro del radio de visión
 47:         }
 48:         else
 49:         {
 50:             jugadorEnVista = false; // El jugador está fuera del radio de visión o el juego ha terminado
 51:         }
 52:         // Comportamiento: Si el jugador está en vista y no está en la zona segura, perseguirlo. Si no, deambular.
 53:         if (jugadorEnVista && PuedoVerAlJugador() && !playerController.safeZone && GameOver == false)
 54:         {
 55:             PerseguirJugador();
 56:         }
 57:         else
 58:         {
 59:             DeambularAletorio();// Si el jugador no está en vista o está en la zona segura, deambular
 60:         }
 61:         // Cambios de estado basados en el puntaje del jugador
 62:         if (gameManager.objectScore == 3 && GameOver == false)
 63:         {
 64:             walkUp = true; // El enemigo empieza a caminar erguido después de recoger 3 objetos
 65:             anim.SetBool("Up", true); // Activa la animación de caminar erguido
 66:             anim.SetBool("Walk", true); // Activa la animación de caminar
 67:             run = 5f; // Aumenta la velocidad al perseguir después de recoger 3 objetos
 68:             walk = 3f; // Aumenta la velocidad al deambular después de recoger 3 objetos
 69:             roadRate = 15f; // Aumenta el radio de deambulación después de recoger 3 objetos
 70:             visionRate = 20f; // Aumenta el radio de visión después de recoger 3 objetos
 71:             StartCoroutine(StateStop()); // Inicia la corrutina para volver a caminar normal después de 7.5 segundos
 72:         }
 73:         // Si el jugador ha recogido 6 objetos, el enemigo se vuelve aún más rápido y agresivo
 74:         if (gameManager.objectScore == 6)
 75:         {
 76:             run = 6f; // Velocidad máxima al perseguir después de recoger 6 objetos
 77:             walk = 5f; // Velocidad máxima al deambular después de recoger 6 objetos
 78:             roadRate = 30f; // Radio de deambulación máximo después de recoger 6 objetos
 79:             visionRate = 40f; // Radio de visión máximo después de recoger 6 objetos
 80:         }
 81:         if (walkUp == true)
 82:         {
 83:             agente.isStopped = true;
 84:             agente.ResetPath();
 85:         }
 86:     }
 87:     // Función para perseguir al jugador
 88:     void PerseguirJugador() 
 89:     {
 90:         // Si el jugador está en vista y el juego no ha terminado, perseguirlo
 91:         if (walkUp == false && GameOver == false)
 92:         {
 93:             // El NavMesh Agent se encarga de ir hacia el jugador sin chocarse
 94:             agente.SetDestination(jugador.position);
 95:             agente.speed = run; // Opcional: Aumentar velocidad al perseguir
 96:             anim.SetFloat("Runing", 1); // Activa la animación de correr estableciendo el parámetro "Runing" en el Animator a 1
 97:         }
 98:     }
 99:     // Si el jugador no está en vista o está en la zona segura, deambular
100:     void DeambularAletorio() 
101:     {
102:         agente.speed = walk; // Volver a velocidad normal
